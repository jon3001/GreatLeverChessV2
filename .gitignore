# Hugo build output — regenerated by `hugo` on every build, and will
# actively conflict with GitHub Pages/Netlify/Cloudflare Pages builders
# that expect to write it themselves.
/public/

# Hugo Pipes / asset pipeline cache (fingerprinted CSS, resized images,
# etc). Rebuilt automatically; committing it just bloats the repo with
# binary diffs every time an image is touched.
/resources/_gen/

# Lock file Hugo writes while a build/server is running (`hugo server`).
# Machine-local and momentary — never meant to be shared.
/.hugo_build.lock

# OS-generated clutter from Finder/Explorer, not project content.
# macOS, Windows and Linux entries side by side since the club's
# contributors aren't all on the same platform.
.DS_Store
.AppleDouble
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory

# Local environment overrides / secrets some Hugo setups use for
# deploy tokens or API keys. Never commit credentials.
.env
.env.local

# .NET / C# build output. Not part of the current Hugo stack, but
# covered in case a build helper or Cloudflare Worker written in C#
# ends up living alongside the site — bin/obj are always regenerated
# and *.user holds machine-local IDE state, never shared config.
bin/
obj/
*.user
*.userosscache
*.sln.docstates
project.lock.json
*.nupkg
TestResults/

# Cloudflare Workers (wrangler) local dev state and secrets. Only
# relevant if Worker functions are added later alongside the static
# site — wrangler.toml itself is normal config and should stay
# committed, unlike its local runtime state below.
.wrangler/
.dev.vars
.dev.vars.*

# Visual Studio — solution/user cache, regenerated per machine.
.vs/

# Visual Studio Code — workspace settings here are personal
# preference, not project-standard config (there's no shared VS Code
# task/launch setup to keep in sync), so the whole folder is ignored
# rather than allowlisting individual files.
.vscode/

# JetBrains IDEs (Rider, WebStorm, IntelliJ) — per-user project state.
.idea/
*.iml
out/
